{
  "name": "desktop-task-planner",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build && node scripts/prepare-dist.mjs",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "desktop": "npm run build:web && electron .",
    "dist": "npm run build:web && electron-builder",
    "dist:win": "npm run build:web && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.0",
    "next": "^16.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.8",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.local.desktop-task-planner",
    "productName": "Desktop Task Planner",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/docs/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
